        "## 2. Data Cleaning & Feature Engineering\n",
        "Ensuring structural integrity, handling null fields, correcting types, and mapping calculated monetary features."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 764
        },
        "id": "4d2eb29e",
        "outputId": "0f95f8f2-2fe4-4d9b-c64a-5dea4c72871e"
      },
      "source": [
        "# Copy dataframe for processing\n",
        "df = raw_df.copy()\n",
        "\n",
        "# 1. Check for duplicates\n",
        "duplicates_count = df.duplicated(subset=['TransactionID']).sum()\n",
        "print(f\"Duplicate transactions found: {duplicates_count}\")\n",
        "\n",
        "# 2. Handle missing CustomerIDs\n",
        "null_customers = df['CustomerID'].isnull().sum()\n",
        "print(f\"Null CustomerID records: {null_customers} (Imputing as 'Guest')\")\n",
        "df['CustomerID'] = df['CustomerID'].fillna('Guest')\n",
        "\n",
        "# 3. Assert correct datatypes\n",
        "df['Timestamp'] = pd.to_datetime(df['Timestamp'])\n",
        "df['Quantity'] = df['Quantity'].astype(int)\n",
        "df['UnitPrice'] = df['UnitPrice'].astype(float)\n",
        "\n",
        "# 4. Feature Engineering: Total Revenue & Date Dimensions\n",
        "df['Revenue'] = df['Quantity'] * df['UnitPrice']\n",
        "df['MonthYear'] = df['Timestamp'].dt.to_period('M')\n",
        "df['MonthName'] = df['Timestamp'].dt.strftime('%B')\n",
        "df['MonthNum'] = df['Timestamp'].dt.month\n",
        "\n",
        "display(df.info())\n",
        "display(df.head())"
      ],
