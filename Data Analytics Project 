        "## 1. Data Ingestion & Synthesis\n",
        "Generating a realistic transaction-level dataset spanning the calendar year 2023 to simulate production sales databases."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 310
        },
        "id": "9bf724c5",
        "outputId": "b4e3f772-3e70-4573-e374-c0179216e4d9"
      },
      "source": [
        "# Seed for reproducibility\n",
        "np.random.seed(42)\n",
        "\n",
        "# Generate realistic dimensions\n",
        "n_records = 5000\n",
        "start_date = datetime(2023, 1, 1)\n",
        "\n",
        "categories = ['Electronics', 'Apparel', 'Home & Kitchen', 'Beauty', 'Sports']\n",
        "products = {\n",
        "    'Electronics': ['Smartphone', 'Laptop', 'Headphones', 'Smartwatch', 'Charger'],\n",
        "    'Apparel': ['T-Shirt', 'Jeans', 'Jacket', 'Sneakers', 'Socks'],\n",
        "    'Home & Kitchen': ['Blender', 'Coffee Maker', 'Air Fryer', 'Cookware Set', 'Vacuum'],\n",
        "    'Beauty': ['Lipstick', 'Foundation', 'Perfume', 'Skincare Set', 'Mascara'],\n",
        "    'Sports': ['Yoga Mat', 'Dumbbells', 'Water Bottle', 'Running Shoes', 'Backpack']\n",
        "}\n",
        "\n",
        "prices = {\n",
        "    'Smartphone': 699.99, 'Laptop': 999.99, 'Headphones': 149.99, 'Smartwatch': 249.99, 'Charger': 19.99,\n",
        "    'T-Shirt': 24.99, 'Jeans': 49.99, 'Jacket': 89.99, 'Sneakers': 79.99, 'Socks': 9.99,\n",
        "    'Blender': 59.99, 'Coffee Maker': 89.99, 'Air Fryer': 119.99, 'Cookware Set': 149.99, 'Vacuum': 199.99,\n",
        "    'Lipstick': 19.99, 'Foundation': 34.99, 'Perfume': 79.99, 'Skincare Set': 49.99, 'Mascara': 14.99,\n",
        "    'Yoga Mat': 29.99, 'Dumbbells': 49.99, 'Water Bottle': 14.99, 'Running Shoes': 89.99, 'Backpack': 39.99\n",
        "}\n",
        "\n",
        "# Synthesize records\n",
        "data = []\n",
        "for i in range(n_records):\n",
        "    tx_id = f\"TX{10000 + i}\"\n",
        "    date = start_date + timedelta(days=np.random.randint(0, 365)) + timedelta(hours=np.random.randint(0, 24))\n",
        "    cat = np.random.choice(categories)\n",
        "    prod = np.random.choice(products[cat])\n",
        "    qty = np.random.choice([1, 2, 3, 4, 5], p=[0.6, 0.25, 0.1, 0.04, 0.01])\n",
        "    unit_price = prices[prod]\n",
        "\n",
        "    # Introduce some synthetic missingness for demonstration of clean-up step\n",
        "    cust_id = f\"C{np.random.randint(1000, 2500)}\" if np.random.rand() > 0.02 else np.nan\n",
        "\n",
        "    data.append([tx_id, date, cust_id, cat, prod, qty, unit_price])\n",
        "\n",
        "raw_df = pd.DataFrame(data, columns=['TransactionID', 'Timestamp', 'CustomerID', 'Category', 'Product', 'Quantity', 'UnitPrice'])\n",
        "display(raw_df.head())\n",
        "print(f\"Raw dataset shape: {raw_df.shape}\")"
      ],
